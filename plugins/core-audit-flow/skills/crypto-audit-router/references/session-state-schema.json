{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zkcrypto-audit.local/session-state-schema.json",
  "title": "zkcrypto-audit session state (v3)",
  "description": "Engagement session handoff. One candidate list carries every suspected issue through its whole life; one route list records which skills ran, which were skipped, and why. Paths are relative to the engagement directory unless they point into the audited target.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engagement_id",
    "phase",
    "targets",
    "trust_boundaries",
    "critical_paths",
    "unresolved_assumptions",
    "routes",
    "candidates",
    "artifacts",
    "remediation_verifications",
    "next_steps",
    "updated_at",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "engagement_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier; equals the engagement directory name."
    },
    "phase": {
      "type": "string",
      "enum": [
        "intake_pending",
        "domain_in_progress",
        "verification_in_progress",
        "reporting_in_progress",
        "remediation_in_progress",
        "closed"
      ]
    },
    "targets": {
      "type": "array",
      "description": "Codebases, modules, revisions, or protocols under review.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "trust_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "assumption"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "assumption": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "critical_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "entry": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          }
        }
      }
    },
    "unresolved_assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "routes": {
      "type": "array",
      "description": "One entry per skill considered for this engagement.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill", "status"],
        "properties": {
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["pending", "completed", "skipped"]
          },
          "reason": {
            "type": "string",
            "description": "Why the route applies, or why it was skipped."
          },
          "summary": {
            "type": "string",
            "description": "What the route covered and concluded."
          },
          "candidate_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "skipped"
                }
              }
            },
            "then": {
              "required": ["reason"],
              "properties": {
                "reason": {
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "completed"
                }
              }
            },
            "then": {
              "required": ["summary"],
              "properties": {
                "summary": {
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "candidates": {
      "type": "array",
      "description": "Every suspected issue raised during the engagement, whatever became of it.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "summary"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "unverified",
              "verified",
              "false_positive",
              "observation",
              "residual_risk"
            ],
            "description": "unverified: raised, awaiting crypto-fp-check or more evidence. verified: passed every verification gate. false_positive: a gate failed, with the reason recorded. observation: true but not a vulnerability. residual_risk: accepted or out-of-scope exposure worth recording."
          },
          "severity": {
            "type": "string",
            "enum": ["Critical", "High", "Medium", "Low", "Informational"]
          },
          "owner_skill": {
            "type": "string"
          },
          "location": {
            "type": "string",
            "description": "file:line or function in the audited target."
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verdict_rationale": {
            "type": "string",
            "description": "Which gate failed, or the evidence that satisfied each gate."
          },
          "poc_status": {
            "type": "string",
            "enum": ["executed", "pending_poc", "not_required"]
          },
          "poc_ref": {
            "type": "string"
          },
          "report_ref": {
            "type": "string"
          },
          "prior_art_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "verified"
                }
              }
            },
            "then": {
              "required": ["severity", "poc_status"]
            }
          }
        ]
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reports", "pocs", "index_refs"],
      "properties": {
        "reports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pocs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "index_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "remediation_verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "fix_ref",
          "verdict",
          "regression_evidence_refs",
          "verified_at"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "fix_ref": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "enum": ["fixed", "partially_fixed", "not_fixed", "regressed"]
          },
          "regression_evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verified_at": {
            "type": "string"
          }
        }
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "updated_at": {
      "type": "string"
    },
    "extensions": {
      "type": "object",
      "description": "Engagement-specific evidence that has no core field. Never drop evidence; carry it here."
    }
  }
}
